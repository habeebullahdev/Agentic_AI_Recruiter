# ==========================================
# Application Configuration
# ==========================================
APP_NAME="Agentic AI Recruitment Assistant"
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# ==========================================
# Security & JWT Authentication
# ==========================================
# Generate secure key via `openssl rand -hex 32`
SECRET_KEY=change_this_to_a_super_secret_jwt_key_in_production_32_bytes_minimum
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=recruitment_ai_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Synchronous DB URL (for SQLAlchemy & Alembic)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recruitment_ai_db

# ==========================================
# Google Gemini API & LLM Settings
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# ==========================================
# ChromaDB & Vector Store
# ==========================================
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_RESUMES=resumes_collection
CHROMA_COLLECTION_JDS=jds_collection

# ==========================================
# File Upload Configuration
# ==========================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=["pdf"]

# ==========================================
# Initial Admin Credentials (Optional Seed)
# ==========================================
FIRST_SUPERUSER_EMAIL=admin@recruitmentai.com
FIRST_SUPERUSER_PASSWORD=AdminSecurePass123!
